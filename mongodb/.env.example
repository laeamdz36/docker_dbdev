# Project and container identity
COMPOSE_PROJECT_NAME=mongodb-dev
MONGO_CONTAINER_NAME=mongodb-dev

# MongoDB image and host settings
MONGO_IMAGE_TAG=8.0
MONGO_HOST_PORT=27017
MONGO_VOLUME_NAME=mongodb_data

# Database created during first initialization.
# MongoDB creates it when the first collection is written.
MONGO_DATABASE=app

# Mongo Express web UI settings
MONGO_EXPRESS_IMAGE_TAG=1.0.2
MONGO_EXPRESS_CONTAINER_NAME=mongo-express-dev
MONGO_EXPRESS_HOST_PORT=8081
MONGO_EXPRESS_COOKIE_SECRET=change-this-cookie-secret
MONGO_EXPRESS_SESSION_SECRET=change-this-session-secret